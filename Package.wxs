<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="Onboarding App Automation"
    Manufacturer="Shore360"
    Version="1.0.0.0"
    UpgradeCode="fa8d0c96-7101-4b2d-ac3d-b82f2fc88384">

    <StandardDirectory Id="ProgramFiles64Folder">

      <Directory
        Id="INSTALLFOLDER"
        Name="OnboardingAppAutomation">

        <Component Id="OnboardingScriptComponent">

          <File
            Id="OnboardingScript"
            Source="onboarding.ps1"
            KeyPath="yes" />

        </Component>

      </Directory>

    </StandardDirectory>

    <Feature Id="MainFeature">

      <ComponentRef Id="OnboardingScriptComponent" />

    </Feature>

    <!-- Optional client name -->
    <Property Id="CLIENTNAME" Secure="yes" />

    <!-- PowerShell executable -->
    <Property Id="POWERSHELL" Value="powershell.exe" />

    <!--
        Launch PowerShell AFTER InstallFinalize.

        This is intentionally NOT WixQuietExec.
        It is a type-50 executable custom action using
        Property + ExeCommand.

        asyncNoWait allows Windows Installer to finish
        without waiting for PowerShell.
    -->

    <CustomAction
      Id="RunOnboardingScript"
      Property="POWERSHELL"
      ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#OnboardingScript]&quot; &quot;[CLIENTNAME]&quot;"
      Execute="immediate"
      Impersonate="no"
      Return="asyncNoWait" />

    <InstallExecuteSequence>

    <Custom
    Action="RunOnboardingScript"
    After="InstallFinalize"
    Condition="NOT Installed" />

    </InstallExecuteSequence>

  </Package>

</Wix>