<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="Onboarding App Automation"
    Manufacturer="Shore360"
    Version="1.0.0.0"
    UpgradeCode="fa8d0c96-7101-4b2d-ac3d-b82f2fc88384">

    <StandardDirectory Id="ProgramFiles64Folder">

      <Directory
        Id="INSTALLFOLDER"
        Name="OnboardingAppAutomation">

        <Component Id="OnboardingScriptComponent">

          <File
            Id="OnboardingScript"
            Source="onboarding.ps1"
            KeyPath="yes" />

        </Component>

      </Directory>

    </StandardDirectory>

    <Feature Id="MainFeature">

      <ComponentRef Id="OnboardingScriptComponent" />

    </Feature>

    <!--
        CLIENTNAME is an MSI property.

        Example:
        msiexec /i onboarding.msi /qn CLIENTNAME=urbanx

        If CLIENTNAME is empty, onboarding.ps1
        will use the standard applications.
    -->

    <Property Id="CLIENTNAME" Secure="yes" />

    <!-- Prepare the PowerShell command -->

    <SetProperty
      Id="RunOnboardingScript"
      Value="&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#OnboardingScript]&quot; &quot;[CLIENTNAME]&quot;"
      Before="RunOnboardingScript"
      Sequence="execute" />

    <!--
        Run onboarding.ps1 AFTER the MSI installation
        has successfully completed.

        This prevents the application's MSI installers
        from becoming nested MSI installations.
    -->

    <CustomAction
      Id="RunOnboardingScript"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="commit"
      Impersonate="no"
      Return="check" />

    <InstallExecuteSequence>

      <Custom
        Action="RunOnboardingScript"
        After="InstallFiles" />

    </InstallExecuteSequence>

  </Package>

</Wix>